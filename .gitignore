# Python/Django standard gitignore

# Virtual environment
myenv/
venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Database
db.sqlite3
db.sqlite3-journal

# Environment variables
.env

# Media files
media/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
